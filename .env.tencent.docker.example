# 复制为 .env 后按需修改（docker compose -f docker-compose.tencent.yml 会自动读取）

# ── 中国大陆环境参数 ─────────────────────────────────────────
# 时区：容器默认 UTC，不设会让"今天/本月/本年度"在 0—8 点整体错一天
TZ=Asia/Shanghai
# 基础镜像：Docker Hub 拉不动时换腾讯云官方镜像副本（CVM 内网免流量）
# BASE_IMAGE=ccr.ccs.tencentyun.com/library/node:22-bookworm-slim


# 首个平台管理员（冷启动引导；首次登录强制改密）
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_USERNAME=yh.admin
BOOTSTRAP_ADMIN_PASSWORD=请改成强密码A1

# 数据准备中心隐藏入口口令（默认 yonghong）
DATA_WORKBENCH_ENTRY_PASSWORD=yonghong

# 32 字节随机密钥（十六进制），启用验证器后保持稳定：openssl rand -hex 32
MFA_TOTP_ENCRYPTION_KEY=

# 仅在"内网 IP 直连、尚未配 HTTPS"的试用阶段置为 1；
# 经 nginx 提供 HTTPS 后务必删除此行（__Host- 安全 Cookie 需要 HTTPS）。
APP_SESSION_ALLOW_INSECURE=1
