# 勇虹医疗设备效益管理平台 · 腾讯云/自托管运行镜像（TencentOS 4 x86_64 适用）
#
# 构建前先在仓库根目录完成产物构建（构建需要 Node >= 22.13）：
#   npm ci && npm run build
# 然后：
#   docker build -f Dockerfile.tencent -t yonghong-platform:$(date +%Y%m%d) .
#
# 运行时组件：Node 22 服务壳（server-node/）直接运行 Cloudflare Worker 构建产物；
# D1 → /data/platform.sqlite；R2 → /data/r2；静态资源本进程直出。
FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0 \
    DATA_DIR=/data \
    NODE_OPTIONS=--disable-warning=ExperimentalWarning

WORKDIR /app

COPY dist ./dist
COPY drizzle ./drizzle
COPY server-node ./server-node

VOLUME /data
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=6s --start-period=15s --retries=3 \
  CMD ["node", "server-node/healthcheck.mjs"]

CMD ["node", "--import", "./server-node/register-loader.mjs", "server-node/server.mjs"]
