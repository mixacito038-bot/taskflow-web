# 腾讯云部署配置 —— deploy.sh 会自动生成同目录下的 .env，一般不用手改
#
# JWT 签名密钥：deploy.sh 自动生成 96 位随机值。
# 千万不要泄露、不要提交到代码仓库；换掉它等于让所有人重新登录一次。
JWT_SECRET=
# 对外端口。腾讯云安全组要放行同一个端口号
WEB_PORT=8912
# 数据目录（SQLite 库、签名图、附件、每日备份）。放在代码目录之外，重传代码不影响数据
DATA_DIR=/opt/medops-data
# 构建后端时用的 npm 源。deploy.sh 每次会自动探测并填入一个能用的
# （国内镜像优先，不通就自动换成官方源），一般不用手改。
NPM_REGISTRY=https://registry.npmmirror.com
# 下面两项由 enable-https.sh 维护，手工不用动：
#   NGINX_CONF=nginx.conf 或 nginx-https.conf
#   WEB_INNER_PORT=80 或 443

# ---- 限流（一般不用改）----
# 医院整栋楼共用一个出口 IP，服务端看来全院就是"一个来源"，所以按全院同时在线来定。
# 真正拦撞库的是账号级防护（连错 5 次冻结）+ 设备级冷却，这两项与下面无关、始终生效。
# 若交接班时有人反馈"提示请求过于频繁"，把对应值调大再执行 bash manage.sh 升级
RL_LOGIN=60      # 每分钟每 IP 的登录尝试上限
RL_GLOBAL=1200   # 每分钟每 IP 的接口调用总上限
