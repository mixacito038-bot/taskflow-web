<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 由 setup.sh 填充占位符后安装到 /Library/LaunchDaemons/
     LaunchDaemon（非 Agent）：开机即启动，不需要有人登录 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <key>ProgramArguments</key>
    <array>
        <string>__NODE__</string>
        <string>__SERVE__</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__DIR__</string>

    <!-- 以安装者身份运行，而不是 root：数据目录归属清晰，也不必要地提权 -->
    <key>UserName</key>
    <string>__USER__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>TZ</key>
        <string>Asia/Shanghai</string>
        <key>NODE_ENV</key>
        <string>production</string>
    </dict>

    <!-- 开机自启 + 进程退出后自动拉起 -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- 崩溃后至少间隔 10 秒再拉起，避免疯狂重启刷日志 -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__LOGDIR__/medops.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGDIR__/medops.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
