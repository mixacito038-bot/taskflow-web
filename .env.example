# Bootstrap the first platform administrator account in a fresh deployment.
BOOTSTRAP_ADMIN_EMAIL=

# Optional: bootstrap the first administrator's password credential so the
# platform is usable without an SSO gateway. On the first password login with
# this username/password an account + credential is created for
# BOOTSTRAP_ADMIN_EMAIL (must-change-password on first login).
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional: overrides the hidden data-workbench entry passphrase.
# Defaults to "yonghong" when unset.
DATA_WORKBENCH_ENTRY_PASSWORD=

# 32 random bytes encoded as hexadecimal, Base64, or Base64URL.
# Keep this value secret and stable after TOTP enrollment is enabled.
